# Force LF line endings for everything that runs inside Linux, WSL2 or a container.
# CRLF endings break bash ("/bin/bash^M: bad interpreter"), Dockerfiles and YAML
# when the repo is checked out on Windows.
* text=auto

*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.txt           text eol=lf
*.md            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
Jenkinsfile     text eol=lf
.dockerignore   text eol=lf
.env.example    text eol=lf
05-docker-apparmor/my-apparmor-profile text eol=lf

*.png           binary
*.jpg           binary
