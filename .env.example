# Copy this file to .env (which is git-ignored) and fill in your own values:
#
#   cp .env.example .env
#
# Never commit .env. Never put a GitHub Personal Access Token (PAT) in any file
# in this repo; let git prompt for it or use a credential helper / `gh auth login`.

# Exercise 4: root password for the throwaway MySQL container. Any value works.
MYSQL_ROOT_PASSWORD=change-me

# Exercises 7-9: your GitHub username, used to build repo URLs in the commands.
GITHUB_USERNAME=your-github-username

# Exercise 3 (optional): your Docker Hub username, only if you push the image.
DOCKERHUB_USERNAME=your-dockerhub-username
